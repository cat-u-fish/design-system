{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Semantic Colors - Complete color system for light and dark modes",
  "text-colors": {
    "primary": {
      "value": "#212121",
      "type": "color",
      "$description": "主文本颜色 - 标题、正文主要内容",
      "$extensions": {
        "mode": {
          "light": "#212121",
          "dark": "#FAFAFA"
        },
        "contrast": {
          "light": "16.1:1",
          "dark": "14.5:1"
        },
        "wcag": "AAA"
      }
    },
    "secondary": {
      "value": "#757575",
      "type": "color",
      "$description": "次要文本颜色 - 辅助说明、标签",
      "$extensions": {
        "mode": {
          "light": "#757575",
          "dark": "#E0E0E0"
        },
        "contrast": {
          "light": "4.61:1",
          "dark": "9.8:1"
        },
        "wcag": "AA"
      }
    },
    "tertiary": {
      "value": "#9E9E9E",
      "type": "color",
      "$description": "三级文本颜色 - 占位符、次要信息",
      "$extensions": {
        "mode": {
          "light": "#9E9E9E",
          "dark": "#BDBDBD"
        },
        "contrast": {
          "light": "2.68:1",
          "dark": "6.2:1"
        },
        "wcag": "AA (dark mode only)"
      }
    },
    "disabled": {
      "value": "#BDBDBD",
      "type": "color",
      "$description": "禁用文本颜色 - 不可交互元素",
      "$extensions": {
        "mode": {
          "light": "#BDBDBD",
          "dark": "#757575"
        },
        "contrast": {
          "light": "1.88:1",
          "dark": "3.1:1"
        },
        "wcag": "Fail"
      }
    },
    "inverse": {
      "value": "#FFFFFF",
      "type": "color",
      "$description": "反色文本 - 用于深色按钮/卡片上的文字",
      "$extensions": {
        "mode": {
          "light": "#FFFFFF",
          "dark": "#212121"
        },
        "usage": "On dark backgrounds"
      }
    },
    "link": {
      "value": "#1976D2",
      "type": "color",
      "$description": "链接文本颜色",
      "$extensions": {
        "mode": {
          "light": "#1976D2",
          "dark": "#42A5F5"
        },
        "contrast": {
          "light": "4.64:1",
          "dark": "6.8:1"
        },
        "wcag": "AA"
      }
    },
    "linkHover": {
      "value": "#1565C0",
      "type": "color",
      "$description": "链接悬停颜色",
      "$extensions": {
        "mode": {
          "light": "#1565C0",
          "dark": "#64B5F6"
        },
        "contrast": {
          "light": "5.85:1",
          "dark": "8.9:1"
        },
        "wcag": "AA"
      }
    },
    "linkVisited": {
      "value": "#7B1FA2",
      "type": "color",
      "$description": "已访问链接颜色",
      "$extensions": {
        "mode": {
          "light": "#7B1FA2",
          "dark": "#BA68C8"
        },
        "contrast": {
          "light": "8.2:1",
          "dark": "3.56:1"
        },
        "wcag": "AAA"
      }
    }
  },
  "background-colors": {
    "primary": {
      "value": "#FFFFFF",
      "type": "color",
      "$description": "主背景颜色 - 页面基础背景",
      "$extensions": {
        "mode": {
          "light": "#FFFFFF",
          "dark": "#212121"
        },
        "usage": "Main page background"
      }
    },
    "secondary": {
      "value": "#FAFAFA",
      "type": "color",
      "$description": "次级背景颜色 - 卡片、面板",
      "$extensions": {
        "mode": {
          "light": "#FAFAFA",
          "dark": "#424242"
        },
        "usage": "Cards, panels, elevated surfaces"
      }
    },
    "tertiary": {
      "value": "#F5F5F5",
      "type": "color",
      "$description": "三级背景颜色 - 悬浮、表格斑马纹",
      "$extensions": {
        "mode": {
          "light": "#F5F5F5",
          "dark": "#616161"
        },
        "usage": "Hover states, table stripes"
      }
    },
    "elevated": {
      "value": "#FFFFFF",
      "type": "color",
      "$description": "提升背景 - 模态框、下拉菜单",
      "$extensions": {
        "mode": {
          "light": "#FFFFFF",
          "dark": "#424242"
        },
        "usage": "Modals, dropdowns, tooltips"
      }
    },
    "overlay": {
      "value": "rgba(0, 0, 0, 0.5)",
      "type": "color",
      "$description": "遮罩层背景",
      "$extensions": {
        "mode": {
          "light": "rgba(0, 0, 0, 0.5)",
          "dark": "rgba(0, 0, 0, 0.7)"
        },
        "usage": "Modal backdrop"
      }
    },
    "disabled": {
      "value": "#F5F5F5",
      "type": "color",
      "$description": "禁用背景颜色",
      "$extensions": {
        "mode": {
          "light": "#F5F5F5",
          "dark": "#424242"
        },
        "usage": "Disabled inputs, buttons"
      }
    },
    "input": {
      "value": "#FFFFFF",
      "type": "color",
      "$description": "输入框背景",
      "$extensions": {
        "mode": {
          "light": "#FFFFFF",
          "dark": "#424242"
        },
        "usage": "Input fields, textareas"
      }
    },
    "code": {
      "value": "#F5F5F5",
      "type": "color",
      "$description": "代码块背景",
      "$extensions": {
        "mode": {
          "light": "#F5F5F5",
          "dark": "#424242"
        },
        "usage": "Code blocks, pre tags"
      }
    }
  },
  "border-colors": {
    "primary": {
